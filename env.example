# Nobryn environment variables
#
# Copy this file to `.env` (never committed — see .gitignore) and fill in values.
# Placeholders only: never put real credentials, certificates, or secrets here.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the API server.
# Source: your PostgreSQL provider (e.g. Aiven / Neon) connection string.
DATABASE_URL=

# Complete PEM CA certificate of the database server's CA (BEGIN through END).
# Used to verify the database TLS certificate; the API and seed refuse to
# connect without it. Source: your database provider's CA certificate
# (e.g. the CA shown for your Aiven PostgreSQL service).
DATABASE_CA_CERT=

# Secret used to sign and verify auth tokens (JWT).
# Required in production; generate with: openssl rand -hex 32
# Source: you generate this value. NEVER commit the real value.
JWT_SECRET=

# --- Optional ---------------------------------------------------------------

# Comma-separated allowed browser origins for CORS.
# Leave empty to allow all origins (development only). Set to your domain in production.
CORS_ORIGIN=

# --- Development-only -------------------------------------------------------

# Backend API port when running next to the Vite dev server (set by `bun run
# dev:all`). In production the API binds to PORT instead. Leave unset outside dev.
API_PORT=

# Port for the Vite dev/preview server (usually injected by the hosting platform).
PORT=

# Path to a bogus CA PEM used only by server/scripts/verify-tls.mjs to prove that TLS
# verification rejects untrusted certificates. Optional; defaults to /tmp/fake-ca.pem.
TLS_BOGUS_CA=
