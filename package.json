{
  "name": "nobryn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd client dev",
    "dev:server": "bun run --cwd server dev",
    "dev:all": "concurrently -k -n web,api -c blue,magenta \"bun run --cwd client dev\" \"bun run --cwd server dev\"",
    "build": "bun run --cwd client build",
    "build:server": "bun run --cwd server build",
    "start": "bun run --cwd server start",
    "typecheck": "bun run --cwd client typecheck && bun run --cwd server typecheck",
    "seed": "bun run --cwd server seed",
    "db:push": "bun run --cwd server db:push",
    "db:deploy": "bun run --cwd server db:deploy",
    "db:generate": "bun run --cwd server db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
