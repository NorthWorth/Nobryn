{
  "name": "nobryn-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "API_PORT=4000 tsx watch index.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "seed": "tsx seed.ts",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "verify:tls": "node scripts/verify-tls.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
